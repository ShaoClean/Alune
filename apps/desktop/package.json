{
  "name": "desktop",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "build": "node scripts/stage.mjs && npm run agent:stage",
    "start": "electron dist/app",
    "pack": "electron-builder --projectDir dist/app --config ../../electron-builder.cjs --dir",
    "dist": "electron-builder --projectDir dist/app --config ../../electron-builder.cjs",
    "test": "npm run test:unit && node scripts/smoke.mjs",
    "test:unit": "node --test test/*.test.cjs",
    "test:proxy": "node scripts/test-proxy.mjs",
    "agent:stage": "node scripts/stage-agent.mjs",
    "prepack": "npm run build",
    "predist": "npm run build",
    "build:candidate": "node scripts/stage.mjs --candidate && npm run agent:stage",
    "predist:candidate": "npm run build:candidate",
    "dist:candidate": "electron-builder --projectDir dist/candidate-app --config ../../electron-builder.cjs --publish never"
  },
  "devDependencies": {
    "@alune/agent": "*",
    "@alune/agent-client": "*",
    "@alune/domain": "*",
    "@alune/protocol": "*",
    "web": "*"
  },
  "dependencies": {
    "builder-util-runtime": "^9.7.0",
    "electron-updater": "^6.8.9",
    "semver": "^7.8.0",
    "undici": "^7.30.0"
  }
}
