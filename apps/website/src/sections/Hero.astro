---
import Screenshot from '../components/Screenshot.astro';
import Icon from '../components/Icon.astro';
import light from '../assets/screenshots/workspace-light.png';
import dark from '../assets/screenshots/workspace-dark.png';
import { site } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-brand">
        Alune <span>桌面 Git 客户端</span>
      </p>
      <h1 id="hero-title">
        你的 Git 工作区，<span>从本地到远程。</span>
      </h1>
      <p class="hero-lede">
        打开本机仓库，连接 SSH 开发机。
        <br />
        从按行暂存到跨仓库 PR/MR 审阅，在同一个工作区完成。
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#download">
          下载 Alune{' '}
          <span class="orb">
            <Icon name="right" />
          </span>
        </a>
        <a class="button" href={site.repository}>
          <Icon name="github" /> GitHub
        </a>
      </div>
    </div>
    <figure class="hero-visual" data-screenshot-tilt>
      <div class="shell">
        <div class="core">
          <Screenshot
            image={light}
            dark={dark}
            alt="Alune 工作区：顶部本机与 SSH 仓库标签，中央文本差异，右侧暂存与提交面板"
            eager
            sizes="(max-width: 1023px) 94vw, 60vw"
          />
        </div>
      </div>
    </figure>
  </div>
</section>
<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: 92px 0 104px;
  }
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -80px -10% -70px;
    background:
      radial-gradient(ellipse at 80% 35%, var(--halo-indigo), transparent 48%),
      radial-gradient(ellipse at 20% 85%, var(--halo-cyan), transparent 46%);
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(360px, 0.92fr) minmax(0, 1.28fr);
    gap: 38px;
    align-items: center;
    min-height: 510px;
  }
  .hero-copy {
    position: relative;
  }
  .hero-brand {
    font-size: 22px;
    font-weight: 550;
    letter-spacing: -0.04em;
    margin-bottom: 28px;
  }
  .hero-brand span {
    font-size: 12px;
    color: var(--muted);
    font-weight: 400;
    letter-spacing: 0.04em;
    border-left: 1px solid var(--hair);
    padding-left: 16px;
    margin-left: 12px;
  }
  h1 {
    font-size: clamp(36px, 3.7vw, 54px);
    line-height: 1.3;
    font-weight: 550;
    letter-spacing: -0.065em;
  }
  h1 span {
    display: block;
    color: var(--accent);
  }
  .hero-lede {
    font-size: 16px;
    line-height: 1.9;
    color: var(--muted);
    margin-top: 25px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .hero-visual {
    width: 120%;
    max-width: 900px;
    transform: perspective(1500px) rotateY(-5deg) rotateZ(1deg);
  }
  .hero-visual .shell {
    padding: 9px;
    border-radius: 26px;
  }
  @media (min-width: 1600px) {
    .hero-visual {
      width: 112%;
    }
  }
  @media (max-width: 1023px) {
    .hero {
      padding: 64px 0 52px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 48px;
    }
    h1 {
      font-size: clamp(38px, 6vw, 60px);
    }
    .hero-copy {
      max-width: 620px;
    }
    .hero-visual {
      width: 100%;
      transform: none;
      max-width: none;
    }
  }
  @media (max-width: 639px) {
    .hero {
      padding-top: 42px;
    }
    .hero-brand {
      margin-bottom: 20px;
    }
    h1 {
      font-size: clamp(30px, 7.8vw, 46px);
    }
    .hero-lede {
      font-size: 14px;
    }
    .hero-visual .shell {
      padding: 5px;
      border-radius: var(--radius-shell);
    }
  }
</style>
