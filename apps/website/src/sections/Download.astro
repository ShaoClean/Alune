---
import Icon from '../components/Icon.astro';
import { site, platforms } from '../data/site';
---

<section class="section download" id="download" aria-labelledby="download-title">
  <div class="container">
    <div data-reveal class="download-intro">
      <img
        src={`${import.meta.env.BASE_URL}brand.png`}
        width="72"
        height="72"
        alt="Alune 头像"
        loading="lazy"
      />
      <h2 class="section-title" id="download-title">
        下一个项目，从这里开始。
      </h2>
      <p class="section-lede">
        选择你的平台，在最新稳定版 Release 中下载安装包。
        <br />
        安装即用，无需另行安装 Node.js 或启动后端。
      </p>
    </div>
    <div class="platforms">
      {platforms.map((platform, index) => (
        <article data-reveal data-reveal-delay={index * 70} class="platform shell">
          <div class="core">
            <div class="platform-title">
              <Icon name={platform.icon} />
              <h3>
                {platform.name}
                <span>{platform.architecture}</span>
              </h3>
            </div>
            <p>{platform.instruction}</p>
            <p class="filename mono">Alune-&lt;版本&gt;-{platform.file}</p>
            <a
              href={site.download}
              class="text-link"
              aria-label={`前往最新稳定版 Release，下载 ${platform.name} ${platform.architecture} 安装包`}
            >
              前往 Release 下载 <Icon name="arrow" />
            </a>
          </div>
        </article>
      ))}
    </div>
    <div class="install-notes">
      <p>
        本机使用需安装 Git。Release 提供 SHA256SUMS 校验文件。当前安装包尚未配置平台签名，macOS
        尚未公证；首次启动可能出现系统提示。
      </p>
      <a class="text-link" href={site.installation}>
        阅读安装与更新说明 <Icon name="arrow" />
      </a>
    </div>
    <div class="resources">
      <a href={site.docs}>
        使用文档 <Icon name="arrow" />
      </a>
      <a href={site.changelog}>
        更新日志 <Icon name="arrow" />
      </a>
      <a href={site.releases}>
        全部版本 <Icon name="arrow" />
      </a>
      <a href={site.feedback}>
        问题反馈 <Icon name="arrow" />
      </a>
    </div>
  </div>
</section>
<style>
  .download {
    background:
      radial-gradient(ellipse at 70% 25%, var(--halo-cyan), transparent 60%),
      radial-gradient(ellipse at 15% 20%, var(--halo-indigo), transparent 65%);
  }
  .download-intro img {
    border-radius: 20px;
    box-shadow: var(--nav-shadow);
    margin-bottom: 24px;
  }
  .platforms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
  }
  .platform .core {
    padding: 26px 30px;
  }
  .platform-title {
    display: flex;
    gap: 15px;
    align-items: center;
  }
  .platform-title > :global(.icon) {
    color: var(--accent);
    font-size: 32px;
  }
  h3 {
    font-size: 23px;
    font-weight: 550;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 15px;
  }
  h3 span {
    font-size: 13px;
    color: var(--muted);
    font-weight: 400;
  }
  .platform p {
    font-size: 13px;
    color: var(--muted);
    margin-top: 20px;
  }
  .platform .filename {
    font-size: 11px;
    margin: 8px 0;
    overflow-wrap: anywhere;
  }
  .install-notes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 40px;
    margin: 28px 6px 0;
  }
  .install-notes p {
    font-size: 12px;
    max-width: 740px;
    color: var(--muted);
  }
  .install-notes a {
    font-size: 13px;
  }
  .resources {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    padding-top: 30px;
    margin-top: 32px;
    border-top: 1px solid var(--hair);
  }
  .resources a {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-size: 14px;
    min-height: 36px;
  }
  .resources a:hover {
    color: var(--accent);
  }
  @media (max-width: 767px) {
    .platforms {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .platform .core {
      padding: 24px;
    }
    .install-notes {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .resources {
      gap: 10px 24px;
    }
  }
</style>
