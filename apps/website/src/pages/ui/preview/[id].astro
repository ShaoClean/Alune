---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@alune/ui/styles.css';
import DemoRoot from '../../../examples/DemoRoot';
import { examples } from '../../../examples/registry';
export function getStaticPaths() {
  return examples.map((example) => ({ params: { id: example.id }, props: { example } }));
}
const { example } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{example.title} · Alune-UI 独立预览</title>
    <meta name="description" content={`${example.title}的隔离式真实交互示例。`} />
    <link rel="canonical" href={canonical} />
    <script is:inline>
      const query = new URLSearchParams(location.search);
      document.documentElement.dataset.theme = query.get('theme') === 'dark' ? 'dark' : 'light';
      document.documentElement.dataset.reducedMotion = String(
        query.get('motion') === 'reduced' || matchMedia('(prefers-reduced-motion: reduce)').matches,
      );
    </script>
  </head>
  <body>
    <main aria-label={example.title}>
      <DemoRoot id={example.id} client:only="react" />
    </main>
    <noscript>
      运行示例需要 JavaScript；
      <a href={`${import.meta.env.BASE_URL}ui/`}>返回文档阅读 API 与源码</a>。
    </noscript>
  </body>
</html>
<style is:global>
  html,
  body {
    margin: 0;
    min-height: 100%;
    background: var(--content);
    color: var(--text);
    font-family: var(--font-sans);
  }
  main {
    padding: 24px;
    overflow-wrap: anywhere;
  }
  main > .ant-space,
  main > label,
  main > output,
  main > span {
    margin-block: 8px;
  }
  main > label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  main > label,
  main > output {
    margin-right: 12px;
  }
  main > p {
    line-height: 1.6;
  }
  main > input,
  main > textarea {
    margin-bottom: 12px;
  }
  main pre {
    max-width: 100%;
    overflow: auto;
  }
  noscript {
    display: block;
    padding: 24px;
  }
</style>
