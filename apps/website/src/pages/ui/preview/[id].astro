---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@alune/ui/styles.css';
import '../../../styles/ui-examples.css';
import DemoRoot from '../../../examples/DemoRoot';
import { examples } from '../../../examples/registry';
export function getStaticPaths() {
  return examples.map((example) => ({ params: { id: example.id }, props: { example } }));
}
const { example } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{example.title} · Alune-UI 独立预览</title>
    <meta name="description" content={`${example.title}的隔离式真实交互示例。`} />
    <link rel="canonical" href={canonical} />
    <script is:inline>
      const query = new URLSearchParams(location.search);
      document.documentElement.dataset.theme = query.get('theme') === 'dark' ? 'dark' : 'light';
      document.documentElement.dataset.reducedMotion = String(
        query.get('motion') === 'reduced' || matchMedia('(prefers-reduced-motion: reduce)').matches,
      );
    </script>
  </head>
  <body>
    <main aria-label={example.title}>
      <DemoRoot id={example.id} client:only="react" />
    </main>
    <noscript>
      运行示例需要 JavaScript；
      <a href={`${import.meta.env.BASE_URL}ui/`}>返回文档阅读 API 与源码</a>。
    </noscript>
  </body>
</html>
