---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/motion.css';
import { site } from '../data/site';
interface Props { title?: string; description?: string; }
const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(`${import.meta.env.BASE_URL}og-image.png`, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#edf1f9" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Alune 本地与 SSH 远程 Git 工作区" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let preference = 'system';
        try {
          preference = localStorage.getItem('alune-website-theme') || 'system';
        } catch {}
        const query = new URLSearchParams(location.search).get('theme');
        if (query === 'light' || query === 'dark' || query === 'system') preference = query;
        if (!['light', 'dark', 'system'].includes(preference)) preference = 'system';
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme =
          preference === 'system'
            ? matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : preference;
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { initScrollMotion } from '../scripts/motion';
      initScrollMotion();
      const root = document.documentElement;
      const media = matchMedia('(prefers-color-scheme: dark)');
      const select = document.querySelector<HTMLSelectElement>('#theme');
      const applyTheme = () => {
        const preference = root.dataset.themePreference || 'system';
        const theme = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
        root.dataset.theme = theme;
        document.querySelectorAll<HTMLSourceElement>('[data-theme-source]').forEach((source) => {
          source.media = theme === 'dark' ? 'all' : 'not all';
        });
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#0a1120' : '#edf1f9');
        if (select) select.value = preference;
      };
      select?.addEventListener('change', () => {
        root.dataset.themePreference = select.value;
        try {
          localStorage.setItem('alune-website-theme', select.value);
        } catch {}
        // A preview query is one-time input; subsequent reloads use the chosen preference.
        const url = new URL(location.href);
        if (url.searchParams.has('theme')) {
          url.searchParams.delete('theme');
          history.replaceState(null, '', url);
        }
        applyTheme();
      });
      media.addEventListener('change', applyTheme);
      applyTheme();
      document.querySelector<HTMLElement>('[data-theme-control]')?.removeAttribute('hidden');
    </script>
  </body>
</html>
