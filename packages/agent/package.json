{
  "name": "@alune/agent",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "alune-agent": "./bin/alune-agent.cjs"
  },
  "scripts": {
    "build": "tsc -b && node scripts/version.cjs && node scripts/native-secrets.mjs",
    "dev": "tsc -b --watch",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@alune/agent-client": "*",
    "@alune/protocol": "*",
    "@alune/domain": "*",
    "better-sqlite3": "^13.0.3",
    "node-pty": "1.1.0",
    "socks": "^2.8.10",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^6.0.3",
    "@types/better-sqlite3": "^7.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./network": {
      "types": "./dist/adapters/network/proxy-transport.d.ts",
      "default": "./dist/adapters/network/proxy-transport.js"
    },
    "./logging": {
      "types": "./dist/adapters/logging/index.d.ts",
      "default": "./dist/adapters/logging/index.js"
    },
    "./secrets-file": {
      "types": "./dist/adapters/secrets/file.d.ts",
      "default": "./dist/adapters/secrets/file.js"
    },
    "./settings": {
      "types": "./dist/modules/settings/index.d.ts",
      "default": "./dist/modules/settings/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "network": [
        "dist/adapters/network/proxy-transport.d.ts"
      ],
      "logging": [
        "dist/adapters/logging/index.d.ts"
      ],
      "secrets-file": [
        "dist/adapters/secrets/file.d.ts"
      ],
      "settings": [
        "dist/modules/settings/index.d.ts"
      ]
    }
  }
}
